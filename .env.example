# EUDI Trusted List Publisher configuration

# Enable the data-collection and administration GUI (Phase 3)
DATA_COLLECTION_GUI=false

# Authoring store directory for mutable application records
AUTHORING_DIR=./authoring

# Administrator access token for the backoffice UI
TLP_ADMIN_TOKEN=changeme-testing-tool-only

# Signing configuration file (JSON or YAML)
# Maps list keys to signing key/cert paths
TLP_SIGNING_CONFIG=./signing-config.json

# Example signing-config.json:
# {
#   "lists": [
#     {
#       "listKey": "eu_credimi",
#       "family": "wallet-providers",
#       "keyFile": "./keys/signing-key.pem",
#       "certFile": "./keys/signing-cert.pem"
#     }
#   ]
# }

# Scheme operator configuration (used as trusted defaults for all Wallet Provider lists)
TLP_SCHEME_OPERATOR_NAME=Credimi
TLP_SCHEME_NAME=EU Wallet Providers List
TLP_SCHEME_TERRITORY=EU
TLP_SCHEME_OPERATOR_STREET=Via Roma 1
TLP_SCHEME_OPERATOR_COUNTRY=IT
TLP_SCHEME_OPERATOR_CONTACT_URI=https://credimi.eu
TLP_DISTRIBUTION_POINT_URI=https://credimi.eu/wallet-providers/latest

# Server configuration
TLP_PUBLICATION_DIR=./publications
TLP_HOST=127.0.0.1
TLP_PORT=8080
