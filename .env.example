# EUDI Trusted List Publisher configuration

# Enable the data-collection and administration GUI (Phase 3)
DATA_COLLECTION_GUI=false
# The same opt-in GUI enables Wallet and PID Provider onboarding.

# Authoring store directory for mutable application records
AUTHORING_DIR=./authoring

# Administrator access token for the backoffice UI
# REQUIRED when DATA_COLLECTION_GUI=true. Must not be empty.
TLP_ADMIN_TOKEN=changeme-testing-tool-only

# Administrator sign-in credentials for /admin
# When BOTH are set, /admin asks for a username and password instead of a token.
ADMIN_USER=user_user
ADMIN_PASSWORD=admin_admin

# Signing configuration file (JSON or YAML)
# Maps list keys to signing key/cert paths and scheme operator details
TLP_SIGNING_CONFIG=./.local-signing/signing-config.json

# Server configuration
TLP_PUBLICATION_DIR=./publications
TLP_HOST=127.0.0.1
TLP_PORT=8080
