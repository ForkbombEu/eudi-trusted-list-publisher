# EUDI Trusted List Publisher configuration

# Enable the data-collection and administration GUI.
# It provides onboarding for every implemented family across both standards,
# the administration backoffice, and healthy/broken Trusted List creation.
DATA_COLLECTION_GUI=false

# Authoring store directory for mutable application records
AUTHORING_DIR=./authoring

# Administrator access token for the backoffice UI
# REQUIRED when DATA_COLLECTION_GUI=true. Must not be empty.
TLP_ADMIN_TOKEN=changeme-testing-tool-only

# Administrator sign-in credentials for /admin
# When BOTH are set, /admin asks for a username and password instead of a token.
ADMIN_USER=user_user
ADMIN_PASSWORD=admin_admin

# Signing configuration file (JSON or YAML)
# Maps list keys to signing key/cert paths and scheme operator details
TLP_SIGNING_CONFIG=./.local-signing/signing-config.json

# Root for key/certificate pairs generated from Admin -> Create Trusted List.
# Keep this directory persistent, private and outside the web publication root.
TLP_CERTIFICATES_DIR=./.local-signing/certificates

# Fixture generation artifacts (scripts/generate-pub-eaa-fixtures.mjs)
# Per-fixture signing key/certificate pairs, and the run report.
# Both are signing/Trusted List artifacts, so they default under .local-signing.
TLP_FIXTURE_KEY_DIR=./.local-signing/fixtures
TLP_FIXTURE_REPORT=./.local-signing/fixture-report.json

# TS 119 612 EAA/QEAA fixture suites (scripts/verify-tsl612-fixtures.mjs).
# Holds the generated publications, their signing config and the run report.
# A separate directory from TLP_FIXTURE_KEY_DIR: these are complete published
# Trusted Lists, not key material for another generator.
TLP_TSL_FIXTURE_DIR=./.local-signing/tsl612-fixtures

# Trust Inspector base URL, used by `serve`.
# Publishing a version submits the signed artifact to this service, so it is a
# third-party upload. Set it to an empty string to disable the integration
# entirely: no published artifact then leaves the process, and every version
# reports its Inspector status as unavailable — which is not a conformance
# statement. Tests never contact it.
TLP_INSPECTOR_URL=https://trust-inspector.credimi.io

# Server configuration
TLP_PUBLICATION_DIR=./publications
TLP_HOST=127.0.0.1
TLP_PORT=8080
